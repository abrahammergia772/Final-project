  "slot_stats": {
    "1_10": {
      "mean_count": 606.8,
      "ns_rate": 0.0,
      "load_label": "Light"
    }
  },
  "baseline_noshow_rate": 0.1759,
  "overbooking_policy": {
    "description": "Book N extra slots per 10 scheduled to compensate predicted no-shows",
    "low_risk": 1,
    "medium_risk": 2,
    "high_risk": 3
  },
  "reminder_timing": {
    "very_high_risk": "72 hours before + day-of reminder",
    "high_risk": "48 hours before",
    "medium_risk": "24 hours before",
    "low_risk": "2 hours before"
  },
  "input": {
    "patient_age": "int",
    "appointment_date": "YYYY-MM-DD",
    "appointment_time": "HH:MM (24h)",
    "department": "string",
    "doctor_id": "string",
    "appointment_type": "Scheduled|Walk-in|Emergency|Follow-up|Teleconsult",
    "gender": "Male|Female",
    "insurance_type": "string",
    "reminder_channel": "SMS|Phone|Email|None",
    "prev_no_shows": "int",
    "prev_visits": "int",
    "distance_km": "float"
  },
  "output": {
    "no_show_probability": "float 0-100%",
    "show_prediction": "Will Show | Will Not Show",
    "predicted_patient_load": "Busy | Moderate | Light",
    "recommended_overbooking_slots": "int",
    "best_reminder_timing": "string",
    "risk_level": "Low | Medium | High | Very High"
  }
}