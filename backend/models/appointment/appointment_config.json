    "month_sin",
    "month_cos",
    "is_monday",
    "is_friday",
    "is_weekend",
    "is_morning",
    "is_afternoon",
    "is_peak_hour",
    "wait_days",
    "wait_bucket",
    "wait_long",
    "log_wait",
