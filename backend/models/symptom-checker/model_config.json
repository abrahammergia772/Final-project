{
  "project": "Wolaita Sodo Hospital",
  "module": "Module 7 — Symptom Checker Chatbot AI",
  "author": "Ab — Wolaita Sodo University",
  "version": "1.0.0",
  "ensemble": {
    "method": "weighted_soft_voting",
    "rf_weight": 0.5175,
    "xgb_weight": 0.4825
